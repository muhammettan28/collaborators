<mjml>
  <mj-include path="./partial/header.mjml" />

  <mj-body mj-class="bg--blue-100">
    <!--
      We load django tags here so they appear in the body of the HTML output.
      This ensures html-to-text also includes them in the plain text template.
    -->
    <mj-raw>{% load i18n static extra_tags %}</mj-raw>
    <mj-wrapper css-class="wrapper" padding="5px 25px 0px 25px">
      <mj-section css-class="wrapper-logo">
        <mj-column>
          <!-- A logo image when one is configured, else the brand name as a text wordmark.
               Collaborators: small enough to hold on one row of a phone screen -->
          <mj-raw>{% if logo_img %}</mj-raw>
          <mj-image
            src="{{logo_img}}"
            width="320px"
            align="left"
            alt="{%trans 'Logo email' %}"
          />
          <mj-raw>{% else %}</mj-raw>
          <mj-text
            align="left"
            font-family="Inter, sans-serif"
            font-size="16px"
            font-weight="800"
            font-style="italic"
            color="#4747A3"
          >
            {{brandname|wordmark}}
          </mj-text>
          <mj-raw>{% endif %}</mj-raw>
        </mj-column>
      </mj-section>
      <mj-section
        mj-class="bg--white-100"
        css-class="content"
        padding="0px 20px 60px 20px"
      >
        <mj-column>
          <!-- Collaborators: the logo of the workspace, space or page one is invited to -->
          <mj-raw>{% if item_logo_img %}</mj-raw>
          <mj-image
            src="{{item_logo_img}}"
            width="96px"
            align="center"
            padding="30px 25px 0px 25px"
            alt=""
          />
          <mj-raw>{% endif %}</mj-raw>
          <mj-text align="center" font-family="Inter, sans-serif">
            <h1>{{title|capfirst}}</h1>
          </mj-text>
          <!-- Main Message -->
          <mj-text font-family="Inter, sans-serif">
            {{message|capfirst}}
            <a href="{{link}}">{{link_label}}</a>
          </mj-text>
          <!-- Collaborators: invitations sent together, each with its logo -->
          <mj-raw>{% if invitations %}</mj-raw>
          <mj-text font-family="Inter, sans-serif">
            {% for invitation in invitations %}
            <p style="margin:8px 0;">
              {% if invitation.logo %}<img src="{{invitation.logo}}" width="32" alt="" style="vertical-align:middle;margin-right:10px;" />{% endif %}{{invitation.label|capfirst}}
            </p>
            {% endfor %}
          </mj-text>
          <mj-raw>{% endif %}</mj-raw>
          <mj-button
            href="{{link}}"
            background-color="#000091"
            color="white"
            padding-bottom="30px"
            font-family="Inter, sans-serif"
          >
            {{button_label}}
          </mj-button>
          <mj-divider
            border-width="1px"
            border-style="solid"
            border-color="#DDDDDD"
            width="30%"
            align="center"
          />
          <!-- Collaborators: the tagline opens with the brand's name in its
               logo's style (plain in the text version, see bin/html-to-plain-text) -->
          <mj-text font-family="Inter, sans-serif">
            {% blocktrans with brandname=brandname|default:"CO✍️✍️ABORATORS"|wordmark %}
              {{brandname}}, where teams organize and share knowledge together.
            {% endblocktrans %}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>